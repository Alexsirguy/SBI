# Paste into Dokploy's Environment tab for docker-compose.dokploy.yml.

# Existing MariaDB; the containers build DATABASE_URL from these, so any password characters work.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Public URLs: web domain for CORS and bucket uploads, api domain baked into the web build.
WEB_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# At least 32 random characters, e.g. `openssl rand -hex 32`.
UPLOAD_TOKEN_SECRET=

# External S3/R2; browsers PUT photos here, and the key must be allowed to set bucket CORS.
# R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto. AWS: path style false.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=sbi-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Recognition and lessons (ADR 0006); without a key and LESSON_MODEL, those routes answer 503.
META_MODEL_API_KEY=
OPENAI_API_KEY=
LESSON_MODEL=

# Required in production: account confirm/reset links are emailed through ZeptoMail.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
# Use https://api.zeptomail.eu/v1.1/email for an EU account.
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# Google sign-in (ADR 0020); blank ids hide the Google button.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional; every other key in apps/api/.env.example can be set here too.
FEATURE_FLAGS=
NEXT_PUBLIC_FEATURE_FLAGS=
NEXT_PUBLIC_MIXPANEL_TOKEN=
EVIDENCE_CONTACT=
