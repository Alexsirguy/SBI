  "kettle": {
    "lesson": {
      "lessonId": "0192f1a0-0000-7000-8000-0000000e0001",
      "version": 1,
      "title": "Why your kettle takes a while to boil",
      "summary": "The element heats the water from below; how much water and how much power decide how long it takes.",
      "claims": [
        {
          "claimId": "0192f1a0-0000-7000-8101-000000000001",
          "text": "A kettle's heating element turns electrical energy into heat.",
          "status": "supported",
          "sourceIds": ["0192f1a0-0000-7000-8000-00000000500a"],
          "scope": "general",
          "confidence": "high",
          "dependsOn": []
        },
        {
          "claimId": "0192f1a0-0000-7000-8101-000000000002",
          "text": "More water needs more energy to heat, so a fuller kettle takes longer to boil.",
          "status": "supported",
          "sourceIds": ["0192f1a0-0000-7000-8000-00000000500a"],
          "scope": "general",
          "confidence": "high",
          "dependsOn": []
        },
        {
          "claimId": "0192f1a0-0000-7000-8101-000000000003",
          "text": "A higher-power element delivers more energy each second, so the water heats faster.",
          "status": "supported",
          "sourceIds": ["0192f1a0-0000-7000-8000-00000000500a"],
          "scope": "general",
          "confidence": "high",
          "dependsOn": []
        },
        {
          "claimId": "0192f1a0-0000-7000-8101-000000000004",
          "text": "Warm water rises and cool water sinks, forming convection currents that spread heat.",
          "status": "supported",
          "sourceIds": ["0192f1a0-0000-7000-8000-00000000500a"],
          "scope": "general",
          "confidence": "high",
          "dependsOn": []
        },
        {
          "claimId": "0192f1a0-0000-7000-8101-000000000005",
          "text": "A bimetallic strip bends when steam heats it and switches the kettle off.",
          "status": "supported",
          "sourceIds": ["0192f1a0-0000-7000-8000-00000000500a"],
          "scope": "general",
          "confidence": "high",
          "dependsOn": []
        },
        {
          "claimId": "0192f1a0-0000-7000-8101-000000000006",
          "text": "Limescale on the element insulates it and slows heating.",
          "status": "supported",
          "sourceIds": ["0192f1a0-0000-7000-8000-00000000500a"],
          "scope": "general",
          "confidence": "high",
          "dependsOn": []
        }
      ],
