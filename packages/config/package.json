{
  "name": "@sbi/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, lint and formatting configuration.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tsconfig/*": "./tsconfig/*",
    "./eslint/*": "./eslint/*.js",
    "./prettier": "./prettier.json"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.1"
  }
}
