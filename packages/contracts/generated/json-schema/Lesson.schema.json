{
  "$id": "Lesson.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lessonId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "taxonomyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "audience": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "child",
          "teen",
          "adult",
          "general"
        ]
      }
    },
    "readingLevel": {
      "type": "string",
      "enum": [
        "simple",
        "plain",
        "technical"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "learningObjectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "concepts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conceptId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            }
          }
        },
        "required": [
          "conceptId",
          "label",
          "prerequisites"
        ],
        "additionalProperties": false
      }
    },
    "misconceptionNotes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
          },
          "module": {
            "type": "string",
            "enum": [
              "what-youre-seeing",
              "short-answer",
              "first-principles",
              "how-parts-work",
              "try-an-idea",
              "history",
              "check-thinking",
              "go-further"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claimIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            }
          }
        },
        "required": [
          "sectionId",
          "module",
          "text",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "qualified",
              "disputed",
              "unsupported"
            ]
          },
          "sourceIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            }
          }
        },
        "required": [
          "claimId",
          "text",
          "status",
          "sourceIds",
          "scope",
          "confidence",
          "dependsOn"
        ],
        "additionalProperties": false
      }
    },
    "visuals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "visualId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "svg-diagram",
              "canvas-diagram",
              "gltf-model",
              "simulation",
              "molecular"
            ]
          },
          "manifestUri": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "visualId",
          "kind",
          "manifestUri",
          "alt"
        ],
        "additionalProperties": false
      }
    },
    "safetyClass": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "generated",
        "auto-validated",
        "needs-review",
        "approved",
        "rejected"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "reuse": {
      "type": "object",
      "properties": {
        "intentSignature": {
          "type": "string",
          "minLength": 1
        },
        "matchDimensions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cacheScope": {
          "type": "string",
          "enum": [
            "private",
            "shared"
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "validatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "evidenceSnapshotId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "sourceFreshness": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "lastUserConfirmationAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "reuseCount": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalidationReason": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "intentSignature",
        "matchDimensions",
        "cacheScope",
        "generatedAt",
        "evidenceSnapshotId",
        "sourceFreshness",
        "modelVersion",
        "promptVersion",
        "policyVersion",
        "reuseCount",
        "contentHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "lessonId",
    "version",
    "taxonomyId",
    "title",
    "locale",
    "audience",
    "readingLevel",
    "summary",
    "learningObjectives",
    "assumptions",
    "concepts",
    "misconceptionNotes",
    "sections",
    "claims",
    "visuals",
    "safetyClass",
    "reviewStatus",
    "reuse"
  ],
  "additionalProperties": false
}
