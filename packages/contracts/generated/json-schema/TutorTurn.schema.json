{
  "$id": "TutorTurn.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "accountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "turnId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "lessonId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "lessonVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "userText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "retrievedClaimIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "citedClaimIds": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "lesson",
            "beyond-lesson",
            "clarifying",
            "policy",
            "fallback"
          ]
        },
        "visualAction": {
          "type": "object",
          "properties": {
            "visualId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "settings": {
              "default": [],
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "controlId": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]{0,39}$"
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "controlId",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "step": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "highlight": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]{0,39}$"
            }
          },
          "required": [
            "visualId",
            "settings"
          ],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "reason": {
              "default": "harm",
              "type": "string",
              "enum": [
                "harm",
                "age"
              ]
            },
            "suitableFor": {
              "type": "string",
              "enum": [
                "teen",
                "adult"
              ]
            },
            "category": {
              "type": "string",
              "enum": [
                "medical",
                "chemical-exposure",
                "weapons",
                "self-harm",
                "dangerous-biology"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "help": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "policyVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "required": [
            "reason",
            "message",
            "help",
            "policyVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "text",
        "citedClaimIds"
      ],
      "additionalProperties": false
    },
    "safetyCategory": {
      "type": "string",
      "enum": [
        "none",
        "medical",
        "chemical-exposure",
        "weapons",
        "self-harm",
        "dangerous-biology",
        "other"
      ]
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    },
    "feedback": {
      "type": "string",
      "enum": [
        "helpful",
        "not-helpful"
      ]
    },
    "retentionClass": {
      "type": "string",
      "enum": [
        "session",
        "account",
        "quality-review",
        "research-consented"
      ]
    },
    "consentVersion": {
      "type": "string",
      "pattern": "^consent-\\d+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "sessionId",
    "turnId",
    "lessonId",
    "lessonVersion",
    "userText",
    "retrievedClaimIds",
    "response",
    "safetyCategory",
    "modelVersion",
    "promptVersion",
    "retentionClass",
    "createdAt"
  ],
  "additionalProperties": false
}
