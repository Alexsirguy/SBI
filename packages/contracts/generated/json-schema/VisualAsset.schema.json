{
  "$id": "VisualAsset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "renderer",
        "model",
        "repository",
        "simulation",
        "data"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "creator": {
      "type": "string",
      "minLength": 1
    },
    "softwareLicense": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "assetLicense": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "modified": {
      "type": "boolean"
    },
    "modificationNotes": {
      "type": "string",
      "minLength": 1
    },
    "commercialUse": {
      "type": "string",
      "enum": [
        "allowed",
        "restricted",
        "prohibited",
        "unknown"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accessibilityFallback": {
      "type": "string",
      "minLength": 1
    },
    "reviewOwner": {
      "type": "string",
      "minLength": 1
    },
    "reviewDueOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "approvedLessonIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
      }
    }
  },
  "required": [
    "assetId",
    "kind",
    "sourceUrl",
    "creator",
    "attribution",
    "modified",
    "commercialUse",
    "sha256",
    "format",
    "sizeBytes",
    "accessibilityFallback",
    "reviewOwner",
    "approvedLessonIds"
  ],
  "additionalProperties": false
}
