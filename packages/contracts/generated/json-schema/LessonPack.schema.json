                    "maxLength": 20
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "working": {
                    "minItems": 1,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
