{
  "visualId": "0192f1a0-0000-7000-8000-00000000002a",
  "kind": "graph",
  "alt": "Water temperature in a kettle over time, flattening at the boiling point",
  "fallback": { "text": "The water warms steadily, then stays at 100 °C while it boils." },
  "assumptions": ["Sea level", "No heat lost", "Starts at 20 °C"],
  "labels": [
    {
      "id": "boilingPoint",
      "text": "Boiling point",
      "claimId": "0192f1a0-0000-7000-8000-000000000101"
    }
  ],
  "controls": [
    {
      "id": "power",
      "label": "Heater power",
      "unit": "W",
      "min": 500,
      "max": 3000,
      "step": 100,
      "value": 2000
    },
    {
      "id": "mass",
      "label": "Water",
      "unit": "kg",
      "min": 0.2,
      "max": 1.7,
      "step": 0.1,
      "value": 1
    }
  ],
  "readouts": [
    {
      "id": "timeToBoil",
      "label": "Time to reach 100 °C",
      "unit": "s",
      "formula": "mass * 4190 * 80 / power"
    }
  ],
  "spec": {
    "x": { "name": "t", "label": "Time", "unit": "s", "from": 0, "to": 600, "samples": 61 },
    "series": [
      {
        "name": "temperature",
        "label": "Temperature",
        "unit": "°C",
        "formula": "min(20 + power * t / (mass * 4190), 100)"
      }
    ],
    "vegaLite": { "mark": "line" }
  }
}
