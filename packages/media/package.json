{
  "name": "@sbi/media",
  "version": "0.0.0",
  "private": true,
  "description": "Photo sanitisation (EXIF stripping, type checks), private storage and TTL deletion.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sbi/config": "workspace:*",
    "exifr": "7.1.3",
    "jpeg-js": "0.4.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@sbi/env": "workspace:*",
    "zod": "4.6.7"
  }
}
