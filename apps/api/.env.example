PORT=4000
DATABASE_URL=mysql://sbi:sbi@localhost:3306/sbi
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=sbi-media
S3_ACCESS_KEY_ID=sbi
S3_SECRET_ACCESS_KEY=sbi-local-secret
# Comma list, e.g. tutor,!photoRecognition
FEATURE_FLAGS=
S3_FORCE_PATH_STYLE=true
# clamd from docker-compose; uploads are refused while it is unreachable.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# At least 32 random characters, e.g. `openssl rand -hex 32`.
UPLOAD_TOKEN_SECRET=
# Comma list of web app origins allowed to call the API and PUT photos to the bucket.
WEB_ORIGINS=http://localhost:3000
# Retention (§12); blank uses the defaults: originals 7 days, derivatives 30, logs 90, audit 365.
MEDIA_TTL_ORIGINAL_DAYS=
MEDIA_TTL_DERIVATIVE_DAYS=
MEDIA_TTL_LOG_DAYS=
MEDIA_TTL_AUDIT_DAYS=
MEDIA_TTL_RECOGNISED_GRACE_HOURS=
MEDIA_TTL_STAGING_HOURS=
MEDIA_PURGE_INTERVAL_MINUTES=15
# Lesson feedback: free text is cleared after this many days; per-client sends per hour.
FEEDBACK_DETAILS_RETENTION_DAYS=90
# Retention for tutor turns, evidence packs and catalog gaps (docs/retention.md); blank uses the defaults.
TUTOR_TTL_SESSION_HOURS=
TUTOR_TTL_QUALITY_DAYS=
TUTOR_TTL_RESEARCH_DAYS=
EVIDENCE_PACK_TTL_DAYS=
CATALOG_GAP_TTL_DAYS=
FEEDBACK_MAX_PER_HOUR=20
# Question suggestions per client per hour; past it the fixed five stand in (#325).
QUESTIONS_MAX_PER_HOUR=60
# Evidence sources are re-fetched once older than this; changed ones mark their lessons stale.
EVIDENCE_RECHECK_INTERVAL_MINUTES=360
EVIDENCE_MAX_AGE_DAYS=30
EVIDENCE_RECHECK_BATCH=20
# Overrides the contact in the evidence crawler's User-Agent; Wikimedia asks for one.
EVIDENCE_CONTACT=
# Milliseconds a background evidence gather may run (ADR 0016); lessons never wait for it.
EVIDENCE_BUDGET_MS=120000
# Recognition (ADR 0006): Meta Spark first, GPT-5.4-mini as fallback. On whenever a key is set;
# FEATURE_FLAGS=!photoRecognition turns it off, and /recognitions then answers 503.
META_MODEL_API_KEY=
OPENAI_API_KEY=
RECOGNITION_PROVIDERS=
RECOGNITION_TIMEOUT_MS=
# Certainty bands and the lesson gate; blank uses 0.8, 0.5, likely and 0.2.
RECOGNITION_BAND_LIKELY=
RECOGNITION_BAND_POSSIBLE=
RECOGNITION_LESSON_MIN_CERTAINTY=
RECOGNITION_LESSON_MIN_MARGIN=
# Recognition metadata is deleted after this many days (default 30, max 90).
RECOGNITION_RESULT_TTL_DAYS=
# Lesson generation (E6): needs a provider key above plus a model, e.g. muse-spark-1.3.
# Without both, POST /lessons answers 503.
LESSON_MODEL=
# Accounts (ADR 0020). Google sign-in needs only the OAuth web client id; blank turns it off.
GOOGLE_CLIENT_ID=
# ZeptoMail for confirm/reset emails; blank logs the links instead (local development).
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
ZEPTOMAIL_FROM_NAME=Science Behind It
# Use https://api.zeptomail.eu/v1.1/email for an EU account.
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
SESSION_TTL_DAYS=30
# Secure cookies need https; on by default only when NODE_ENV=production.
SESSION_COOKIE_SECURE=
# Lesson model prices, US dollars per million tokens; set all three to log cost per lesson (#110).
LESSON_PRICE_INPUT_PER_MTOK=
LESSON_PRICE_CACHED_INPUT_PER_MTOK=
LESSON_PRICE_OUTPUT_PER_MTOK=
