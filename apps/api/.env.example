PORT=4000
DATABASE_URL=mysql://sbi:sbi@localhost:3306/sbi
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=sbi-media
S3_ACCESS_KEY_ID=sbi
S3_SECRET_ACCESS_KEY=sbi-local-secret
# Comma list, e.g. tutor,!visualLab
FEATURE_FLAGS=
S3_FORCE_PATH_STYLE=true
# Retention (§12); blank uses the defaults: originals 7 days, derivatives 30, logs 90, audit 365.
MEDIA_TTL_ORIGINAL_DAYS=
MEDIA_TTL_DERIVATIVE_DAYS=
MEDIA_TTL_LOG_DAYS=
MEDIA_TTL_AUDIT_DAYS=
MEDIA_TTL_RECOGNISED_GRACE_HOURS=
MEDIA_TTL_STAGING_HOURS=
MEDIA_PURGE_INTERVAL_MINUTES=15
