PORT=4000
DATABASE_URL=mysql://sbi:sbi@localhost:3306/sbi
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=sbi-media
S3_ACCESS_KEY_ID=sbi
S3_SECRET_ACCESS_KEY=sbi-local-secret
# Comma list, e.g. tutor,!visualLab
FEATURE_FLAGS=
S3_FORCE_PATH_STYLE=true
# clamd from docker-compose; uploads are refused while it is unreachable.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# At least 32 random characters, e.g. `openssl rand -hex 32`.
UPLOAD_TOKEN_SECRET=
# Comma list of web app origins allowed to call the API and PUT photos to the bucket.
WEB_ORIGINS=http://localhost:3000
# Retention (§12); blank uses the defaults: originals 7 days, derivatives 30, logs 90, audit 365.
MEDIA_TTL_ORIGINAL_DAYS=
MEDIA_TTL_DERIVATIVE_DAYS=
MEDIA_TTL_LOG_DAYS=
MEDIA_TTL_AUDIT_DAYS=
MEDIA_TTL_RECOGNISED_GRACE_HOURS=
MEDIA_TTL_STAGING_HOURS=
MEDIA_PURGE_INTERVAL_MINUTES=15
# Evidence sources are re-fetched once older than this; changed ones mark their lessons stale.
EVIDENCE_RECHECK_INTERVAL_MINUTES=360
EVIDENCE_MAX_AGE_DAYS=30
EVIDENCE_RECHECK_BATCH=20
# Overrides the contact in the evidence crawler's User-Agent; Wikimedia asks for one.
EVIDENCE_CONTACT=
# Recognition (ADR 0006): Meta Spark first, GPT-5.4-mini as fallback. On whenever a key is set;
# FEATURE_FLAGS=!photoRecognition turns it off, and /recognitions then answers 503.
META_MODEL_API_KEY=
OPENAI_API_KEY=
RECOGNITION_PROVIDERS=
RECOGNITION_TIMEOUT_MS=
# Certainty bands and the lesson gate; blank uses 0.8, 0.5, likely and 0.2.
RECOGNITION_BAND_LIKELY=
RECOGNITION_BAND_POSSIBLE=
RECOGNITION_LESSON_MIN_CERTAINTY=
RECOGNITION_LESSON_MIN_MARGIN=
# Recognition metadata is deleted after this many days (default 30, max 90).
RECOGNITION_RESULT_TTL_DAYS=
# Lesson generation (E6): needs a provider key above plus a model, e.g. muse-spark-1.3.
# Without both, POST /lessons answers 503.
LESSON_MODEL=
