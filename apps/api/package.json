{
  "name": "@sbi/api",
  "version": "0.0.0",
  "private": true,
  "description": "API gateway and session service; composes the module packages into routes.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sbi/db": "workspace:*",
    "@sbi/env": "workspace:*",
    "@sbi/media": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sbi/config": "workspace:*",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
