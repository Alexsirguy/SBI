{
  "name": "@sbi/api",
  "version": "0.0.0",
  "private": true,
  "description": "API gateway and session service; composes the module packages into routes.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest:evidence": "tsx --env-file-if-exists=.env scripts/ingest-evidence.ts",
    "source:facts": "tsx --env-file-if-exists=.env scripts/source-taxonomy-facts.ts",
    "load:evidence": "tsx --env-file-if-exists=.env scripts/load-evidence-snapshot.ts",
    "eval:visuals": "tsx scripts/visual-eval.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@sbi/contracts": "workspace:*",
    "@sbi/db": "workspace:*",
    "@sbi/env": "workspace:*",
    "@sbi/evidence": "workspace:*",
    "@sbi/llm": "workspace:*",
    "@sbi/media": "workspace:*",
    "@sbi/orchestrator": "workspace:*",
    "@sbi/recognition": "workspace:*",
    "@sbi/rights": "workspace:*",
    "@sbi/taxonomy": "workspace:*",
    "@sbi/visuals": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@sbi/config": "workspace:*",
    "@sbi/testing": "workspace:*",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
