NEXT_PUBLIC_API_URL=http://localhost:4000
# Comma list, e.g. tutor,!visualLab
NEXT_PUBLIC_FEATURE_FLAGS=
# Capture limits; blank uses the defaults (1600 px, 0.85 JPEG quality, 10 MB).
NEXT_PUBLIC_CAPTURE_MAX_DIMENSION=
NEXT_PUBLIC_CAPTURE_JPEG_QUALITY=
NEXT_PUBLIC_CAPTURE_MAX_UPLOAD_MB=
# Private photo storage: R2 in production, the SeaweedFS from docker-compose locally.
MEDIA_S3_ENDPOINT=http://127.0.0.1:8333
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=sbi-media
MEDIA_S3_ACCESS_KEY_ID=sbi
MEDIA_S3_SECRET_ACCESS_KEY=sbi-local-secret
MEDIA_S3_FORCE_PATH_STYLE=true
# clamd from docker-compose; uploads are refused while it is unreachable.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# At least 32 random characters, e.g. `openssl rand -hex 32`.
UPLOAD_TOKEN_SECRET=
# Comma list of app origins allowed to PUT photos straight to the bucket.
MEDIA_UPLOAD_ORIGINS=http://localhost:3000
# Registry of stored photos and their deletion dates; uploads stay off without it.
DATABASE_URL=mysql://sbi:sbi@localhost:3306/sbi
