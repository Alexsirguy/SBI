NEXT_PUBLIC_API_URL=http://localhost:4000
# Comma list, e.g. tutor,!visualLab
NEXT_PUBLIC_FEATURE_FLAGS=
# Capture limits; blank uses the defaults (1600 px, 0.85 JPEG quality, 10 MB).
NEXT_PUBLIC_CAPTURE_MAX_DIMENSION=
NEXT_PUBLIC_CAPTURE_JPEG_QUALITY=
NEXT_PUBLIC_CAPTURE_MAX_UPLOAD_MB=
# Optional accounts (ADR 0020): the Auth0 tenant domain, SPA client id and API audience.
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_CLIENT_ID=
NEXT_PUBLIC_AUTH_AUDIENCE=
